# Supabase Postgres connection strings.
# Get both from your Supabase project: Project Settings > Database > Connection string.

# Pooled connection (port 6543, pgbouncer) - used by the app at runtime.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) - used only for running migrations.
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"
